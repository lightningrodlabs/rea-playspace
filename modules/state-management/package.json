{
  "name": "state-management",
  "version": "0.1.0",
  "description": "",
  "author": "Jillian Ada Burrows <jill@adaburrows.com>",
  "license": "MIT",
  "type": "module",
  "files": ["dist"],
  "main": "./dist/state-management.cjs",
  "module": "./dist/state-management.js",
  "exports": {
    ".": {
      "import": "./dist/state-management.js",
      "require": "./dist/state-management.cjs"
    },
    "./fiber": {
      "import": "./dist/fiber.js",
      "require": "./dist/fiber.cjs"
    },
    "./state-machine": {
      "import": "./dist/state-machine.js",
      "require": "./dist/state-machine.cjs"
    }
  },
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "clean": "rm -rf ./dist",
    "lint": "eslint . --ignore-path .gitignore --ext .ts",
    "check": "tsc --noEmit",
    "lint:fix": "pnpm run lint -- --fix",
    "test": "jest",
    "test:ci": "pnpm test",
    "test:watch": "pnpm test -- --watch --verbose"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.15.24",
    "@typescript-eslint/eslint-plugin": "8.33.0",
    "@typescript-eslint/parser": "8.33.0",
    "eslint": "9.27.0",
    "jest": "29.7.0",
    "ts-jest": "29.3.4",
    "typescript": "5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "4.5.4"
  },
  "dependencies": {

  }
}

  "license": "MIT",
  "type": "module",
  "source": "./src/index.ts",
  "main": "./dist/yaati.umd.js",
  "module": "./dist/yaati.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/yaati.js",
      "require": "./dist/yaati.umd.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "clean": "rm -rf ./dist",
    "lint": "eslint . --ignore-path .gitignore --ext .ts",
    "check": "tsc --noEmit",
    "lint:fix": "pnpm run lint -- --fix",
    "test": "jest",
    "test:ci": "pnpm test",
    "test:watch": "pnpm test -- --watch --verbose"
  },
  "dependencies": {
    "data-providers": "workspace:*",
    "lodash": "4.17.21",
    "react": "19.1.0",
    "react-store-adaptors": "0.1.0",
    "typed-object-tweezers": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.15.24",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "@types/react-modal": "3.16.3",
    "@types/react-router-dom": "5.3.3",
    "@typescript-eslint/eslint-plugin": "8.33.0",
    "@typescript-eslint/parser": "8.33.0",
    "@vitejs/plugin-react": "4.5.0",
    "eslint": "9.27.0",
    "jest": "29.7.0",
    "prettier": "3.5.3",
    "react-refresh": "0.17.0",
    "react-refresh-typescript": "2.0.10",
    "terser": "^5.40.0",
    "ts-jest": "29.3.4",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "4.5.4"
  }
}
